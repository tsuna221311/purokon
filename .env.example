# このファイルを .env にコピーして値を設定する（.env はgit管理しないこと）。
# どちらも未設定でも動作する（AI判定は簡易モックにフォールバックする）。

# Claude API（STEP③ パーツ判定に使用。https://console.anthropic.com/ で取得）
ANTHROPIC_API_KEY=

# SAM (Segment Anything Model) のチェックポイントパス（STEP② パーツ分割に使用）。
# 未設定の場合は engine/segmentation.py の簡易シルエット分割にフォールバックする。
# 例: SAM_CHECKPOINT_PATH=/models/sam_vit_b_01ec64.pth
SAM_CHECKPOINT_PATH=

# Flaskの生成物出力先（省略時は generated/）
PATTERNFORGE_OUTPUT_DIR=

# generated/ 内のSVG/PDFを自動削除するまでの秒数（省略時は3600 = 1時間）
PATTERNFORGE_OUTPUT_TTL_SECONDS=3600

# Flaskのセッション署名鍵。ログイン状態・匿名ジョブの所有権をセッション
# クッキーで管理するため必須級の設定。未設定だと起動ごとにランダムな鍵を
# 生成してしまい、複数ワーカー構成ではワーカー間でセッションが壊れる。
# 生成例: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ユーザー・ジョブ所有権・利用回数を保存するSQLiteファイルのパス
# （省略時はプロジェクトルートの patternforge.db）
PATTERNFORGE_DB_PATH=

# イラストアップロードの最大ピクセル数（幅×高さ）。圧縮率の高い画像による
# メモリ枯渇(decompression bomb)対策。省略時は25,000,000(約25メガピクセル)。
PATTERNFORGE_MAX_IMAGE_PIXELS=25000000

# nginx等の信頼できる単一のリバースプロキシの背後で動かす場合のみ1にする。
# 1にすると以下の2つが有効になる:
#   - レート制限のクライアント識別に X-Forwarded-For を使う(そのプロキシが
#     正しく上書きしている場合のみ正しく機能する)。
#   - X-Forwarded-Proto / X-Forwarded-Host を信用してURL生成(スキーム・
#     ホスト名)を補正する(werkzeug.middleware.proxy_fix.ProxyFix)。
#     これが無いと、TLSをプロキシ側で終端しアプリへは平文HTTPで転送する
#     一般的な構成で、確認/パスワード再設定メールに載るURLが常に
#     "http://<アプリの内部アドレス>/..." という外部からアクセスできない
#     リンクになってしまう(実際に確認した実バグ。README参照)。
# そうでない環境で1にすると、クライアントが自分でこれらのヘッダーを送って
# レート制限を迂回したり、他人宛のメールに載るURLのホスト名を書き換え
# られてしまうため、信頼できるプロキシを経由していない場合は0のままにすること。
PATTERNFORGE_TRUST_PROXY_HEADERS=0

# Flask開発サーバのポート（省略時は5000）
PORT=5000

# エラー監視(Sentry、任意。round8で追加)。設定すると想定外の例外を
# sentry_sdk経由で通知する(要 pip install sentry-sdk。未インストールの
# 場合は起動時に警告ログを出すだけで、通常通り動作を継続する)。
# 未設定時はこれまで通りログのみ(app.logger.exception)。
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# パフォーマンストレースのサンプリング率(0.0〜1.0)。省略時は0(オフ)。
SENTRY_TRACES_SAMPLE_RATE=0.0

# メール送信バックエンド（省略時は console = 実際には送信せずログに出力するだけ）。
# 実際にメールを送る場合は "smtp" にして下のSMTP_*も設定する（mailer.py参照）。
PATTERNFORGE_MAIL_BACKEND=console

# SMTP設定（PATTERNFORGE_MAIL_BACKEND=smtp のときのみ使用）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com
# STARTTLS(平文接続→TLSへ切り替え。通常ポート587)を使うか（省略時は1=使う）
SMTP_USE_TLS=1
# 暗黙的TLS(SMTPS。最初からTLSで接続。通常ポート465)を使うか。
# 未設定時はSMTP_PORT=465なら自動的に1(有効)として扱う。465番で
# 平文/STARTTLSしか話さない特殊な構成など、自動判定を上書きしたい場合のみ
# 明示的に0または1を設定する。465番以外のポートで暗黙的TLSを使うプロバイダ
# の場合もここを1にする。
SMTP_IMPLICIT_TLS=
